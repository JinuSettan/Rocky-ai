# Preferred AI provider: OpenAI Responses API.
# Set this secret in the server/deployment environment; NEVER put real keys in frontend code or GitHub.
OPENAI_API_KEY="replace-with-your-server-side-openai-api-key"
# Optional model override. The default in server.ts is gpt-5.5.
OPENAI_MODEL="gpt-5.5"

# Optional Gemini fallback when OPENAI_API_KEY is not configured.
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# APP_URL: URL where this app is hosted (if applicable).
APP_URL="http://localhost:3000"
